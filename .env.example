# ==============================================================================
# 🌸 VRINDAVAN RIDES (MERI DHANNO) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Usage:
#   Copy this file to '.env' in the project root:
#     cp .env.example .env
# ==============================================================================

# ==============================================================================
# 🖥️ BACKEND SERVER CONFIGURATION (Node.js / Express)
# ==============================================================================
# Port where the Express API server listens
PORT=5000

# Node environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Master Admin Security PIN for Platform Administrator portal access
# Used for KYC verification, disputes resolution, and platform settings
ADMIN_PIN=7777

# Allowed CORS origins for API requests
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# 🗄️ DATABASE CONFIGURATION (Supabase PostgreSQL / Cloud SQL)
# ==============================================================================
# Supabase IPv4 Pooler (required for Render / cloud containers without IPv6 support):
DATABASE_URL=postgresql://postgres.xgehhlmkhzekhakmcrcg:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres


# ==============================================================================
# 📧 EMAIL & OTP VERIFICATION (SMTP / Nodemailer)
# ==============================================================================
# If left blank, OTP codes are logged to console and returned for simulated dev testing.
# For production (e.g. Gmail App Password, Brevo, Mailgun, AWS SES):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="\"Vrindavan Rides\" <no-reply@vrindavanrides.in>"

# ==============================================================================
# 📬 EXTERNAL CONTACT FORM EMAIL API (Server-Side Only)
# ==============================================================================
# Token for POST https://shivamdixit.vercel.app/api/send-email
# Never expose this token to the browser/client.
EMAIL_API_TOKEN=
EMAIL_API_ENDPOINT=https://shivamdixit.vercel.app/api/send-email
EMAIL_API_TO=support@vrindavanrides.in

# ==============================================================================
# 🖼️ IMAGEKIT CLOUD STORAGE CONFIGURATION
# ==============================================================================
# Strict limit: 5 MB maximum per photo
# Inspection photos are permanently purged from storage upon final return settlement
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=


# ==============================================================================
# 🌐 FRONTEND CONFIGURATION (Vite / React)
# Note: Vite only exposes environment variables with the 'VITE_' prefix to the browser
# ==============================================================================
# Base URL for Backend API requests:
# - For local development (using Vite reverse proxy configured in vite.config.js): /api
# - For production hosting on Render/Vercel: https://rentmeyoubikebackend.onrender.com/api
VITE_API_URL=/api

# Application Display Title
VITE_APP_TITLE="Vrindavan Rides — P2P Bike & Scooter Rentals"

# Official WhatsApp Support Helpline number (with international dial code)
VITE_SUPPORT_WHATSAPP=+919876543210
