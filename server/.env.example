# ==============================================================================
# 🌸 VRINDAVAN RIDES — BACKEND SERVER ENVIRONMENT TEMPLATE
# ==============================================================================
# Usage:
#   When deploying or running the backend standalone from the server/ directory:
#     cp server/.env.example server/.env
# ==============================================================================

# Port where Express listens
PORT=5000

# Node execution environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Master Admin Security PIN code for Platform Administrator access
ADMIN_PIN=7777

# Allowed CORS origins for API requests
CORS_ORIGIN=http://localhost:3000

# Optional: SQLite Database file path (defaults to ./vrindavan.db in server directory)
# DB_PATH=./vrindavan.db

# ==============================================================================
# 📧 EMAIL & OTP VERIFICATION (SMTP / Nodemailer)
# ==============================================================================
# If left blank, OTP codes are logged to console and returned for simulated dev testing.
# For production (e.g. Gmail App Password, Brevo, Mailgun, AWS SES):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="\"Vrindavan Rides\" <no-reply@vrindavanrides.in>"

# ==============================================================================
# 🖼️ IMAGEKIT CLOUD STORAGE CONFIGURATION
# ==============================================================================
# Strict limit: 5 MB maximum per photo
# Inspection photos are permanently purged from storage upon final return settlement
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
